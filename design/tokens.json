{
  "$meta": {
    "name": "Ecommerce Assistant Design Tokens",
    "version": "1.0.0",
    "status": "approved-for-implementation",
    "derivedFrom": "design/index.html",
    "spec": "design/FRONTEND-SPEC.md",
    "prd": "docs/PRD.md v0.3",
    "note": "框架无关的机器可读 token。CSS 变量映射、组件用法与布局规则见 FRONTEND-SPEC.md。本文件中的尺寸为准；原型的个别正负 2px 差异属实现残差，无需还原。"
  },

  "color": {
    "$note": "四条 route 色同时用于色块与文字，已按 WCAG AA 校验（正文字号下对比度 >= 4.5:1）。route 色只用于表达「这条问题被送到哪条道」，不得用作氛围色或装饰。",
    "surface": {
      "paper": "#E7E8E2",
      "card": "#FBFBF8",
      "raised": "#FFFFFF"
    },
    "text": {
      "ink": "#171A1F",
      "ink2": "#3C4046",
      "mute": "#63675E",
      "onInk": "#FBFBF8"
    },
    "line": {
      "rule": "#C7C9C0",
      "strong": "#171A1F"
    },
    "route": {
      "after": "#C4400C",
      "order": "#2F4BC4",
      "stock": "#3F6B3A",
      "ship": "#8F6410",
      "unknown": "#C4400C"
    },
    "feedback": {
      "fallbackBg": "#FBEFE8",
      "fallbackBorder": "#E8C4AE",
      "online": "#3F6B3A",
      "errorBg": "#FBEFE8",
      "errorBorder": "#E8C4AE"
    }
  },

  "font": {
    "family": {
      "sans": "\"Archivo\", \"Noto Sans SC\", system-ui, -apple-system, \"Segoe UI\", \"Microsoft YaHei\", sans-serif",
      "mono": "\"DM Mono\", ui-monospace, Consolas, \"Courier New\", monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "license": "Archivo、DM Mono、Noto Sans SC 均为 SIL OFL 1.1，可商用。上线前需自托管字体文件，不依赖 Google Fonts CDN。"
  },

  "type": {
    "$note": "字号阶。display 随视口缩放，移动端取 24px 下限。",
    "display":    { "fontSize": "clamp(24px, 3.1vw, 33px)", "fontWeight": 700, "lineHeight": 1.24, "letterSpacing": "-0.012em" },
    "brand":      { "fontSize": "17px", "fontWeight": 700, "lineHeight": 1.3, "letterSpacing": "-0.018em" },
    "chuteName":  { "fontSize": "16px", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "-0.008em" },
    "ask":        { "fontSize": "15.5px", "fontWeight": 500, "lineHeight": 1.62 },
    "body":       { "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.62 },
    "receipt":    { "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.68 },
    "button":     { "fontSize": "14.5px", "fontWeight": 500, "lineHeight": 1.4 },
    "sourceItem": { "fontSize": "13.5px", "fontWeight": 400, "lineHeight": 1.6 },
    "kbItem":     { "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.62 },
    "label":      { "fontSize": "12.5px", "fontWeight": 500, "lineHeight": 1.4 },
    "chip":       { "fontSize": "12.5px", "fontWeight": 400, "lineHeight": 1.4 },
    "micro":      { "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.5 },
    "monoSmall":  { "fontSize": "11px", "fontWeight": 400, "lineHeight": 1.5 },
    "mono":       { "fontSize": "11.5px", "fontWeight": 400, "lineHeight": 1.6 },
    "metric":     { "fontSize": "21px", "fontWeight": 500, "lineHeight": 1.1 },
    "input":      { "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.4 }
  },

  "space": {
    "$note": "4px 基准刻度，含 2px 半档。布局一律从此表取值。",
    "0.5": "2px",
    "1": "4px",
    "1.5": "6px",
    "2": "8px",
    "2.5": "10px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "28px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "14": "56px"
  },

  "radius": {
    "$note": "除按钮外一律直角。这是与 70Materia 保持一致的硬约束。",
    "none": "0",
    "button": "3px"
  },

  "border": {
    "hairline": "1px",
    "accent": "2px",
    "askEdge": "3px",
    "chuteAccent": "7px",
    "belt": "12px",
    "dashedHairline": "1px dashed"
  },

  "size": {
    "shellMaxWidth": "1220px",
    "railWidth": "292px",
    "receiptMaxWidth": "72ch",
    "ledeTitleMaxWidth": "22ch",
    "ledeBodyMaxWidth": "58ch",
    "chuteMinHeight": "124px",
    "chuteMinHeightMobile": "108px",
    "parcelSize": "36px",
    "parcelMark": "10px",
    "lampDot": "8px",
    "kbBullet": "4px",
    "consoleReserve": "156px",
    "consoleReserveMobile": "192px",
    "traceStickyTop": "20px",
    "focusRingWidth": "2px",
    "focusRingOffset": "2px",
    "minTouchTarget": "44px"
  },

  "breakpoint": {
    "$note": "三个断点，语义命名对应发生变化的区域。",
    "railCollapse": "1080px",
    "beltWrap": "760px",
    "chipsScroll": "600px"
  },

  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "150ms",
      "base": "200ms",
      "receiptIn": "340ms",
      "chuteEntry": "460ms",
      "parcelMove": "520ms",
      "parcelDrop": "280ms",
      "chuteActiveHold": "1400ms"
    },
    "easing": {
      "standard": "ease",
      "enter": "ease-out",
      "exit": "ease-out",
      "parcel": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "stagger": {
      "chuteEntry": "60ms",
      "parcelStartDelay": "40ms"
    },
    "$note": "prefers-reduced-motion: reduce 时全部时长降为 0.01ms，并跳过包裹投递全程（直接进入结果态）。"
  },

  "elevation": {
    "$note": "本设计不使用阴影。层级只用背景色与描边表达。",
    "shadow": "none"
  },

  "zIndex": {
    "console": 20
  }
}
