OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://aihub.top/v1
OPENAI_MODEL=gpt-5.6-sol
# 工作台「回复模型」下拉框的候选清单（逗号分隔，顺序即下拉框顺序）。留空则只用 OPENAI_MODEL 单值。
# 名称必须是中转站真实存在的模型 id，否则调用失败会静默回退到知识库回答。
# 也可以在页面点「拉取全部模型」实时读取中转站 /v1/models。
OPENAI_MODELS=gpt-5.5,gpt-5.6,gpt-5.6-luna,gpt-5.6-sol,gpt-5.6-terra
HOST=0.0.0.0
PORT=8084
