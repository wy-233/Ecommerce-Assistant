# 构建上下文瘦身 + 避免把本机状态带进镜像

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.venv*

# 版本控制与本地配置
.git/
.gitignore
.DS_Store
.vscode/
.workbuddy/

# 密钥：不进镜像，运行期由 compose 的 env_file 注入
.env
.env.*

# 本地临时产物（预检模拟目录、临时脚本）
_dockersim/
scripts/_*.py

# 运行时不读取的材料
docs/
design/
tests/

# 数据库文件不入镜像：容器启动时由 FastAPI lifespan 建库并播种，
# 演示数据源 data/demo/*.csv 仍随镜像带入。
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
